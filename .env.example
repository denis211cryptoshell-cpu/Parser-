# Логирование
LOG_LEVEL=DEBUG
LOG_FILE=logs/bot.log

# Парсинг
PARSING_LIMIT=100
CACHE_TTL_L1=300
CACHE_TTL_L2=600
MONITORING_INTERVAL=10

# Pyrogram Userbot (получить на https://my.telegram.org/apps)
API_ID=12345678
API_HASH=your_api_hash_here
USERBOT_SESSION=userbot.session

